# ============================================================================
# Frontend environment variables
# ----------------------------------------------------------------------------
# 1. Copy this file to ".env"  ->  the ".env" file is git-ignored on purpose.
# 2. Fill in the two values from your Supabase project:
#    Supabase Dashboard -> Project Settings -> API
#
# Vite ONLY exposes variables that start with VITE_ to the browser code, and
# anything exposed is public. That is exactly why we use the *anon public* key:
# it is designed to be shipped to the browser, and Row Level Security (RLS) is
# what actually protects the data.
#
# NEVER put the "service_role" key here - it bypasses RLS.
#
# There are only two variables in this project, because Supabase is the only
# backend: no second server, no API URL, no Python service.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
